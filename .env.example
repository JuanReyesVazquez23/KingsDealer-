SECRET_KEY=
ADMIN_USER=
ADMIN_PASS=

# Connection string de PostgreSQL (Neon).
# Usa la versión "pooled" (host con sufijo -pooler) porque la app abre una
# conexión nueva por cada request — sin el pooler se agotan las conexiones
# rápido en un entorno serverless como Vercel.
# Formato: postgresql://usuario:password@host-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=
